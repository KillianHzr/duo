{
  "name": "peinard",
  "version": "0.4.1",
  "private": true,
  "description": "Low-latency private voice chat for your local network",
  "author": "KillianHzr",
  "license": "MIT",
  "homepage": "https://github.com/KillianHzr/duo",
  "repository": {
    "type": "git",
    "url": "https://github.com/KillianHzr/duo.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "tsx server/index.ts",
    "start": "electron-vite preview",
    "test": "npm run typecheck && npm run test:server && npm run test:space && npm run test:gate",
    "test:space": "tsx scripts/test-space.mts",
    "test:server": "tsx scripts/test-server.mts",
    "test:gate": "node scripts/test-gate.mjs",
    "test:voice": "node scripts/e2e-voice.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:store": "electron-vite build && electron-builder --win appx --publish never"
  },
  "build": {
    "appId": "io.github.killianhzr.peinard",
    "productName": "Peinard",
    "artifactName": "Peinard-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "files": [
      "out/**/*",
      "!node_modules/uiohook-napi/{libuiohook,src,build,binding.gyp}",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-arm64,linux-loong64,win32-arm64}"
    ],
    "publish": {
      "provider": "github",
      "owner": "KillianHzr",
      "repo": "duo",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    },
    "appx": {
      "identityName": "KillianHzr.Peinard",
      "publisher": "CN=BC1E0133-4A9D-4472-8E42-79655007027C",
      "publisherDisplayName": "KillianHzr",
      "applicationId": "Peinard",
      "displayName": "Peinard",
      "addAutoLaunchExtension": true,
      "languages": [
        "en-US",
        "fr-FR"
      ],
      "backgroundColor": "#1c1d20"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  }
}
