{
  "name": "duo",
  "version": "0.2.1",
  "private": true,
  "description": "Low-latency private voice chat for your local network",
  "author": "KillianHzr",
  "license": "MIT",
  "homepage": "https://github.com/KillianHzr/duo",
  "repository": {
    "type": "git",
    "url": "https://github.com/KillianHzr/duo.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "tsx server/index.ts",
    "start": "electron-vite preview",
    "test": "npm run typecheck && npm run test:server",
    "test:server": "tsx scripts/test-server.mts",
    "test:voice": "node scripts/e2e-voice.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "build": {
    "appId": "io.github.killianhzr.duo",
    "productName": "Duo",
    "artifactName": "Duo-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "KillianHzr",
      "repo": "duo",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  }
}
